<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="exemplo.diasuteis.view.TipoFeriadoController">
   <padding>
      <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 18px;" text="Cadastro de Tipos de Feriado" />

      <TableView fx:id="tblTipoFeriado" prefHeight="220.0">
         <columns>
            <TableColumn fx:id="colCodigo" prefWidth="80.0" text="Código" />
            <TableColumn fx:id="colTipo" prefWidth="300.0" text="Tipo" />
         </columns>
      </TableView>

      <Label text="Tipo" />
      <TextField fx:id="txtTipo" />

      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="btnNovo" onAction="#btnNovoAction" text="Novo" />
            <Button fx:id="btnDeletar" onAction="#btnDeletarAction" text="Deletar" />
            <Button fx:id="btnSalvar" onAction="#btnSalvarAction" text="Salvar" />
         </children>
      </HBox>
   </children>
</VBox>
